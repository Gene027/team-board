{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "projects": {
    "auth": {
      "type": "library",
      "root": "libs/auth",
      "entryFile": "index",
      "sourceRoot": "libs/auth/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "projects": {
      "type": "library",
      "root": "libs/projects",
      "entryFile": "index",
      "sourceRoot": "libs/projects/src",
      "compilerOptions": {
        "tsConfigPath": "libs/projects/tsconfig.lib.json"
      }
    },
    "tasks": {
      "type": "library",
      "root": "libs/tasks",
      "entryFile": "index",
      "sourceRoot": "libs/tasks/src",
      "compilerOptions": {
        "tsConfigPath": "libs/tasks/tsconfig.lib.json"
      }
    },
    "users": {
      "type": "library",
      "root": "libs/users",
      "entryFile": "index",
      "sourceRoot": "libs/users/src",
      "compilerOptions": {
        "tsConfigPath": "libs/users/tsconfig.lib.json"
      }
    }
  }
}